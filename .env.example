# Copy to `.env` before running `docker compose up`. `.env` is gitignored — keep real values there.

# SQL Server SA password. Must satisfy the SQL Server complexity policy
# (8+ chars, upper + lower + digit + symbol) or the container exits on boot.
MSSQL_SA_PASSWORD=Str0ng!Passw0rd

# Signing key for locally issued JWTs. HMAC-SHA256 needs at least 32 bytes;
# the API refuses to start with anything shorter. Generate one with:
#   openssl rand -base64 48
JWT_KEY=REPLACE_ME_WITH_A_48_BYTE_BASE64_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=epm-api
JWT_AUDIENCE=epm-client

# Seeded demo accounts (admin@epm.local / manager@epm.local / user@epm.local).
SEED_ADMIN_PASSWORD=Admin#12345
SEED_MANAGER_PASSWORD=Manager#12345
SEED_USER_PASSWORD=User#12345

# Entra ID SSO. Leave ENTRA_ENABLED=false to run everything with local auth only —
# the app boots fine without a tenant. See README "Single Sign-On" to switch it on.
ENTRA_ENABLED=false
ENTRA_INSTANCE=https://login.microsoftonline.com/
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
# Scope the SPA requests so its token is audienced for this API. Defaults to
# api://$ENTRA_CLIENT_ID/access_as_user when left blank.
ENTRA_API_SCOPE=
